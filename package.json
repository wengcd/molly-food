{
  "name": "mollys-food",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "sharp"] },
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/prepare-images.mjs && astro dev --host 0.0.0.0",
    "build": "node scripts/prepare-images.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "node scripts/prepare-images.mjs && astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "import:recipes": "node scripts/import-recipes.mjs"
  },
  "dependencies": {
    "astro": "6.3.1",
    "markdown-it": "^14.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
